# Copia este archivo como .env.local y completa los valores.
# Nunca subas .env.local a GitHub. En Vercel, carga los mismos valores en
# Settings → Environment Variables.

# --- Supabase (Project Settings → API Keys) ---------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Clave publicable (sb_publishable_...). Es pública por diseño: los datos los
# protege Row Level Security. Si tu proyecto usa claves antiguas, es la "anon".
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secreta (sb_secret_...), SOLO servidor. Si tu proyecto usa claves
# antiguas, es la "service_role". Se usa para registrar el consumo de IA,
# calcular el presupuesto y revisar la lista de correos permitidos.
SUPABASE_SECRET_KEY=

# URL pública de la app, para los enlaces de los correos (confirmar cuenta,
# recuperar contraseña). En producción: https://tu-app.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Gemini (https://aistudio.google.com/apikey) -----------------------------
GEMINI_API_KEY=

# Modelos (nunca hardcodeados en el código). Revisa nombres y precios vigentes
# en https://ai.google.dev/gemini-api/docs/models y .../pricing, y si usas un
# modelo nuevo agrega su precio en src/lib/ai/pricing.ts.
# Fase 1 solo usa AI_MODEL_MAIN (lectura del sílabo, ~1-5 centavos por sílabo).
# Confirma que el modelo siga disponible. Alternativas: gemini-3-flash-preview,
# gemini-3.5-flash (mejor, pero ~5 veces más caro).
AI_MODEL_MAIN=gemini-2.5-flash
# Desde la fase 2:
AI_MODEL_FAST=gemini-2.5-flash-lite
# Opcional: solo para "explicación profunda" pedida por el usuario.
AI_MODEL_DEEP=
AI_MODEL_EMBEDDING=gemini-embedding-001

# Límite de gasto mensual de IA en USD (toda la app). Al 80 % se avisa en la
# app; al 100 % la IA se pausa hasta el mes siguiente.
AI_MONTHLY_BUDGET_USD=9
